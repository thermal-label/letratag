{
  "name": "@thermal-label/letratag-web",
  "version": "0.0.0",
  "description": "Web Bluetooth driver for the DYMO LetraTag LT-200B",
  "type": "module",
  "author": "Mannes Brak",
  "license": "MIT",
  "homepage": "https://thermal-label.github.io/letratag/",
  "keywords": [
    "dymo",
    "letratag",
    "web-bluetooth",
    "ble",
    "label-printer",
    "thermal-label"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thermal-label/letratag.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/thermal-label/letratag/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@thermal-label/contracts": "^0.5.0",
    "@thermal-label/letratag-core": "workspace:*",
    "@thermal-label/transport": "^0.5.0"
  },
  "devDependencies": {
    "@mbtech-nl/bitmap": "^1.3.0",
    "@mbtech-nl/tsconfig": "^1.1.0",
    "@thermal-label/contracts": "^0.5.0",
    "@thermal-label/letratag-core": "workspace:*",
    "@thermal-label/transport": "^0.5.0",
    "@types/node": "^22.0.0",
    "@types/web-bluetooth": "^0.0.20",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "~5.5.0",
    "vitest": "^2.0.0"
  }
}
